<!-- Adaptive icon foreground: the Linkroid mark,
     two interlocking device loops (Android Phone in Green + PC Desktop in Blue)
     around the center connection nexus, scaled to stay inside the 66dp safe zone
     of the 108dp canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Phone Loop (Android Green) -->
    <path
        android:pathData="M37,30 h6 a10,10 0 0 1 10,10 v28 a10,10 0 0 1 -10,10 h-6 a10,10 0 0 1 -10,-10 v-28 a10,10 0 0 1 10,-10 z"
        android:strokeColor="#00E676"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- PC Desktop Loop (Electric Blue) -->
    <path
        android:pathData="M50,40 h28 a8,8 0 0 1 8,8 v12 a8,8 0 0 1 -8,8 h-28 a8,8 0 0 1 -8,-8 v-12 a8,8 0 0 1 8,-8 z"
        android:strokeColor="#0091FF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Center Connection Nexus -->
    <path
        android:pathData="M48,54m-6,0a6,6 0 1,1 12,0a6,6 0 1,1 -12,0"
        android:fillColor="#38BDF8" />
    <path
        android:pathData="M46.5,52.5m-2.2,0a2.2,2.2 0 1,1 4.4,0a2.2,2.2 0 1,1 -4.4,0"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95" />
</vector>
